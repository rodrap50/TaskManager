# URL of the TaskManager backend API.
# Default dev port is 5062 (see backend/TaskManager.API/Properties/launchSettings.json).
VITE_API_URL=http://localhost:5062

# --- Production builds (PREP.3) ---
# Vite bakes VITE_API_URL into the bundle statically at BUILD time (`vite build`,
# invoked here via `npm run build`) — it is NOT read at container runtime. Setting
# it as an env var on a already-built/running container has no effect.
#
# There is no committed .env.production: the real production API URL is deployment-
# specific and unknown at repo-commit time. Instead, set VITE_API_URL as a real
# environment variable when running the build:
#
#   VITE_API_URL=https://your-real-domain npm run build --workspace=packages/web
#
# A real build-time environment variable always takes precedence over any .env.*
# file (Vite's loadEnv behavior), so this works with no other configuration.
#
# For Docker (Phase 9, D02): pass it as a build ARG, not a runtime ENV — e.g.
#   ARG VITE_API_URL
#   ENV VITE_API_URL=$VITE_API_URL
#   RUN npm run build --workspace=packages/web
# then `docker build --build-arg VITE_API_URL=https://your-real-domain .`
