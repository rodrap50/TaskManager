# Shared by both deployment modes (D05), so the proxy rules can't drift:
#   monolith — rendered at image build time (WEB_ROOT=/app/web, API_UPSTREAM=http://127.0.0.1:8080)
#   web      — rendered at container start by the nginx image's envsubst-on-templates step
#              (WEB_ROOT=/usr/share/nginx/html, API_UPSTREAM defaults to http://api:8080)
server {
    listen 8081;
    server_name _;
    root ${WEB_ROOT};
    index index.html;

    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Avatar images (LocalAvatarStorage) are served outside the /api prefix by the
    # API (app.UseStaticFiles()), so they need their own proxy location — see
    # resolveAssetUrl() in ApiClient.ts.
    location /avatars/ {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $host;
    }

    location / {
        try_files $uri /index.html;
    }
}
