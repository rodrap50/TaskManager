# Copy to .env (kept out of version control) and fill in real values before
# running `docker compose up`. Used as the API's JWT signing key — see
# PREP.4's Production startup guard in backend/TaskManager.API/Program.cs.
JWT_SECRET=

# Microservices mode only (docker-compose.microservices.yml): password for the
# official Postgres container, shared by the api and mcp services.
POSTGRES_PASSWORD=

# Optional — which published images `docker compose pull` fetches. Defaults to
# ghcr.io/rodrap50 and latest; e.g. TASKMANAGER_TAG=1.1.0-rc.1 for a release candidate.
# TASKMANAGER_REGISTRY=ghcr.io/rodrap50
# TASKMANAGER_TAG=latest
